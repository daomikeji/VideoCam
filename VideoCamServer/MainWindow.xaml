<Window x:Class="VideoCamServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="iVCam 桌面端服务器" Height="720" Width="1024" 
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- 视频预览区 -->
            <ColumnDefinition Width="280" />
            <!-- 控制面板区 -->
        </Grid.ColumnDefinitions>

        <!-- 左侧: 视频预览区 (模拟) -->
        <Border Grid.Column="0" Background="#1c1c1e" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 
                    在实际应用中，这里将是高性能的视频渲染控件，例如 Image 配合 WriteableBitmap，
                    或者用于 DirectShow/Media Foundation 渲染的自定义组件。
                -->
                <TextBlock x:Name="VideoStatusText" 
                           Text="等待服务器启动..." 
                           Foreground="#E0E0E0" FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                <Rectangle Width="640" Height="360" Fill="#2C2C2E" RadiusX="10" RadiusY="10" Opacity="0.9">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.5" BlurRadius="15"/>
                    </Rectangle.Effect>
                </Rectangle>
            </StackPanel>
        </Border>

        <!-- 右侧: 控制面板和状态区 -->
        <StackPanel Grid.Column="1" Margin="15" Background="White">
            <TextBlock Text="服务器与连接状态" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333333"/>

            <!-- 启动/停止按钮 -->
            <Button x:Name="ToggleServerButton" 
                    Content="启动服务器" 
                    Click="ToggleServerButton_Click"
                    Background="#007ACC" Foreground="White"
                    BorderBrush="#005C99" BorderThickness="1"
                    Height="45" FontSize="16" Margin="0,0,0,25">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- 状态信息 -->
            <GroupBox Header="网络连接信息" Margin="0,0,0,20" BorderBrush="#AAAAAA">
                <StackPanel >
                    <TextBlock Text="服务器状态:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ServerStatusLabel" Text="已停止" Foreground="Red" FontWeight="Bold" Margin="0,2,0,5"/>

                    <TextBlock Text="客户端 IP:" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock x:Name="ClientIPLabel" Text="无连接" Foreground="#007ACC"/>

                    <TextBlock Text="TCP/控制端口:" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="9000"/>

                    <TextBlock Text="UDP/视频端口:" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="9001"/>
                </StackPanel>
            </GroupBox>

            <!-- 客户端控制状态 (接收自移动端) -->
            <GroupBox Header="移动端控制状态" BorderBrush="#AAAAAA">
                <StackPanel >
                    <TextBlock Text="摄像头方向:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CameraStateLabel" Text="后置" Foreground="#333333" Margin="0,2,0,5"/>

                    <TextBlock Text="闪光灯状态:" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock x:Name="FlashStateLabel" Text="关闭" Foreground="#333333"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>